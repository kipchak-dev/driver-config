{
    "name": "kipchak/driver-config",
    "type": "middleware",
    "description": "A Config Management Kipchak driver (dependency) for the Kipchak API Development Kit (ADK)",
    "keywords": [
        "APIs",
        "HTTP",
        "Microservices",
        "Mamluk",
        "Configuration"
    ],
    "homepage": "https://mamluk.net",
    "license": "MIT",
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Kipchak\\Driver\\Config\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "kipchak/core": "^2 || ^3"
    },
    "extra": {
        "kipchak": {
            "type": "driver",
            "config": null,
            "configName": null,
            "initialise": "\\Kipchak\\Driver\\Config\\Config::initialise($container);",
            "after": [],
            "before": [],
            "docs": "https://kipchak.dev/docs/driver-config"
        }
    }
}
